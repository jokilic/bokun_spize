# All values are positive integers

# Gemini calls per UTC day across meals, summaries, and fallbacks
AI_PROJECT_DAILY_CALL_LIMIT=1000

# AI meal requests per user, measured over a rolling minute and a UTC day
AI_MEAL_MINUTE_LIMIT=3
AI_MEAL_DAILY_LIMIT=25

# Maximum trimmed description length accepted by the AI meal backend
AI_MEAL_MAX_DESCRIPTION_LENGTH=2000

# Gemini output token limits per call
AI_MEAL_MAX_OUTPUT_TOKENS=4096
AI_DAILY_SUMMARY_MAX_OUTPUT_TOKENS=4096
