rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    // Validate profile fields and optional first registration timestamp
    function isValidUserDocument(data) {
      let metricFields = [
        'age',
        'height',
        'weight',
        'gender',
        'dailyCalories',
        'dailyProtein',
        'dailyCarbs',
        'dailyFat',
      ];

      let isRegistrationDocument = data.keys().hasAny(['name', 'registeredAt'])
        && data.keys().hasOnly(['name', 'registeredAt', 'isAdmin'])
        && (!('name' in data) || (data.name is string && data.name.size() <= 200));

      let isMetricsDocument = data.keys().hasAll(['age', 'height', 'weight', 'gender'])
        && data.keys().hasOnly(metricFields.concat(['name', 'registeredAt', 'isAdmin']))
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && data.age is int
        && data.age > 0
        && data.age <= 150
        && data.height is number
        && data.height > 0
        && data.height <= 300
        && data.weight is number
        && data.weight > 0
        && data.weight <= 1000
        && data.gender is string
        && data.gender in ['male', 'female']
        && (!('dailyCalories' in data) || data.dailyCalories == null || (data.dailyCalories is number && data.dailyCalories >= 0))
        && (!('dailyProtein' in data) || data.dailyProtein == null || (data.dailyProtein is number && data.dailyProtein >= 0))
        && (!('dailyCarbs' in data) || data.dailyCarbs == null || (data.dailyCarbs is number && data.dailyCarbs >= 0))
        && (!('dailyFat' in data) || data.dailyFat == null || (data.dailyFat is number && data.dailyFat >= 0));

      return (!('registeredAt' in data) || data.registeredAt is timestamp)
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (isRegistrationDocument || isMetricsDocument);
    }

    // Allow removing all body metrics without changing any other user data
    function isBodyMetricsDeletion() {
      let bodyMetricFields = ['age', 'height', 'weight', 'gender'];

      return !request.resource.data.keys().hasAny(bodyMetricFields)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(bodyMetricFields);
    }

    function isValidNutrition(data) {
      return data is map
        && data.keys().hasAll(['calories', 'protein', 'carbs', 'fat'])
        && data.keys().hasOnly(['calories', 'protein', 'carbs', 'fat'])
        && data.calories is number
        && data.protein is number
        && data.carbs is number
        && data.fat is number;
    }

    // Validate meal fields while allowing creation metadata to be absent on older meals
    function isValidMeal(data, userId, mealId) {
      let fields = [
        'id',
        'name',
        'emoji',
        'color',
        'createdAt',
        'nutrition',
        'foods',
        'originalText',
        'isLoading',
        'errors',
        'imageStoragePath',
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['methodOfCreation', 'imageBlurHash']))
        && data.id is string
        && data.id == mealId
        && isOptionalString(data.name, 500)
        && isOptionalString(data.emoji, 32)
        && isOptionalString(data.color, 16)
        && data.createdAt is timestamp
        && (data.nutrition == null || isValidNutrition(data.nutrition))
        // Firestore Rules cannot validate every element type in an arbitrary list
        && (data.foods == null || (data.foods is list && data.foods.size() <= 200))
        && isOptionalString(data.originalText, 50000)
        && isOptionalString(data.get('methodOfCreation', null), 200)
        && isOptionalString(data.get('imageBlurHash', null), 100)
        && data.isLoading is bool
        && (data.errors == null || (data.errors is list && data.errors.size() <= 100))
        && (
          data.imageStoragePath == null
          || (
            data.imageStoragePath is string
            && data.imageStoragePath.matches('users/' + userId + '/meal-images/[^/]+')
          )
        );
    }

    function isValidWeightTrack(data, weightTrackId) {
      return data.keys().hasAll(['id', 'dateTime', 'weight'])
        && data.keys().hasOnly(['id', 'dateTime', 'weight'])
        && data.id is string
        && data.id == weightTrackId
        && data.dateTime is timestamp
        && data.weight is number
        && data.weight > 0
        && data.weight <= 1000;
    }

    // Validate notification preferences and optional server scheduling metadata
    function isValidNotificationSettings(data) {
      let clientFields = [
        'weighReminderEnabled',
        'dailySummaryEnabled',
        'announcementsEnabled',
        'timezone',
        'locale',
      ];
      let serverFields = [
        'nextWeighReminderAt',
        'lastWeighReminderSentAt',
        'nextDailySummaryAt',
        'lastDailySummarySentAt',
        'lastAnnouncementSentAt',
      ];

      return data.keys().hasAll(clientFields)
        && data.weighReminderEnabled is bool
        && data.dailySummaryEnabled is bool
        && data.announcementsEnabled is bool
        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 100
        && data.timezone.matches('(UTC|[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)+)')
        && data.locale is string
        && data.locale in ['en', 'hr']
        && (!('nextWeighReminderAt' in data) || data.nextWeighReminderAt is timestamp)
        && (!('lastWeighReminderSentAt' in data) || data.lastWeighReminderSentAt is timestamp)
        && (!('nextDailySummaryAt' in data) || data.nextDailySummaryAt is timestamp)
        && (!('lastDailySummarySentAt' in data) || data.lastDailySummarySentAt is timestamp)
        && (!('lastAnnouncementSentAt' in data) || data.lastAnnouncementSentAt is timestamp);
    }

    // Keep scheduling fields writable only by trusted server environments
    function onlyClientNotificationFieldsChanged() {
      let clientFields = [
        'weighReminderEnabled',
        'dailySummaryEnabled',
        'announcementsEnabled',
        'timezone',
        'locale',
      ];

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientFields);
    }

    // Validate a short-lived FCM registration without using its token as the document ID
    function isValidNotificationDevice(data, deviceId) {
      let fields = [
        'token',
        'platform',
        'locale',
        'timezone',
        'appVersion',
        'createdAt',
        'updatedAt',
        'lastActiveAt',
        'expiresAt',
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && deviceId.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
        && data.token is string
        && data.token.size() > 0
        && data.token.size() <= 4096
        && data.platform is string
        && data.platform in ['android', 'iOS', 'macOS', 'windows', 'linux', 'fuchsia', 'web']
        && data.locale is string
        && data.locale in ['en', 'hr']
        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 100
        && data.timezone.matches('(UTC|[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)+)')
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastActiveAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(91, 'd');
    }

    // Preserve registration creation time and require trusted server timestamps on updates
    function isValidNotificationDeviceUpdate(deviceId) {
      return isValidNotificationDevice(request.resource.data, deviceId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActiveAt == request.time;
    }

    // Validate contact messages using the fields serialized by the app
    function isValidContactMessage(data, messageId) {
      let fields = ['id', 'message', 'userUid', 'userEmail', 'appVersion', 'platform', 'createdAt'];
      let email = request.auth.token.get('email', null);

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.id is string
        && data.id == messageId
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 50000
        && data.userUid is string
        && data.userUid == request.auth.uid
        && data.userEmail is string
        && data.userEmail == (email == null ? '--' : email)
        && data.appVersion is string
        && data.appVersion.size() <= 200
        && data.platform is string
        && data.platform.size() <= 10000
        && data.createdAt is timestamp;
    }

    // Allow authenticated submissions and admin-only reads and deletes
    match /contactMessages/{messageId} {
      allow create: if request.auth != null
        && isValidContactMessage(request.resource.data, messageId);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Allow signed-in clients to fetch AI configuration managed by administrators
    match /config/ai {
      allow get: if request.auth != null;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['isAdmin'])
        && isValidUserDocument(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && (isValidUserDocument(request.resource.data) || isBodyMetricsDeletion());

      match /meals/{mealId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidMeal(request.resource.data, userId, mealId);
      }

      match /weightTracks/{weightTrackId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidWeightTrack(request.resource.data, weightTrackId);
      }

      match /notificationSettings/preferences {
        allow get, delete: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'weighReminderEnabled',
            'dailySummaryEnabled',
            'announcementsEnabled',
            'timezone',
            'locale',
          ])
          && isValidNotificationSettings(request.resource.data);
        allow update: if isOwner(userId)
          && isValidNotificationSettings(request.resource.data)
          && onlyClientNotificationFieldsChanged();
      }

      match /notificationDevices/{deviceId} {
        allow get, delete: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidNotificationDevice(request.resource.data, deviceId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastActiveAt == request.time;
        allow update: if isOwner(userId)
          && isValidNotificationDeviceUpdate(deviceId);
      }
    }
  }
}
