{
  "name": "bokun-spize-functions",
  "version": "1.0.0",
  "description": "Server-side notification dispatch for Bokun spize",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --only firestore \"npm test\"",
    "serve": "npm run build && firebase emulators:start --config ../firebase.json --only functions,firestore",
    "deploy": "firebase deploy --config ../firebase.json --only functions,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
